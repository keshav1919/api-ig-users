# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000

# ── Instagram Credentials (REQUIRED for status checking) ──
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
IG_2FA_KEY=your_2fa_secret_key
IG_SESSIONID=
IG_SESSION_FILE=data/ig_session.json

# ── Concurrency ──
MAX_CONCURRENT_CHECKS=5
MAX_BATCH_SIZE=100

# ── Cache TTLs (seconds) ──
CACHE_TTL_SECONDS=45
UNKNOWN_CACHE_TTL_SECONDS=3
PROFILE_CACHE_TTL_SECONDS=300

# ── Timeouts (seconds) ──
CONNECT_TIMEOUT_SECONDS=5
READ_TIMEOUT_SECONDS=10
RETRY_DELAY_SECONDS=0.75

# ── CORS ──
# Comma-separated list of allowed origins (leave empty to allow all)
ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app

# ── API Authentication ──
# Optional API key for server-to-server endpoints (batch status)
# Leave empty to disable API key authentication
API_KEY=

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=30
BATCH_RATE_LIMIT_PER_MINUTE=10

# ── Logging ──
LOG_LEVEL=INFO
