# Copy these values into your environment. Never commit a real bot token.
BOT_TOKEN=YOUR_NEW_BOT_TOKEN

# Shared Backend API Connection (running on Windows RDP / tunnel)
# Example: https://your-backend-api.example.com or http://localhost:8000
SHARED_API_BASE_URL=http://localhost:8000
# Optional API key matching API_KEY on the shared backend
SHARED_API_KEY=

# Bot rate-limiting and behavior settings
USER_COOLDOWN_SECONDS=4
MAX_BATCH_SIZE=100
READ_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
